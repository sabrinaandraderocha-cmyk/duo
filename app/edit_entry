{% extends "base.html" %}

{% block title %}Editar registro • Duo{% endblock %}

{% block content %}
<section class="duo-edit-page">
  <div class="duo-edit-card">
    <div class="duo-edit-heading">
      <a href="/" class="duo-back" aria-label="Voltar para a linha do tempo">←</a>
      <div>
        <span class="duo-kicker">NOSSO DIÁRIO</span>
        <h1>Editar registro ✏️</h1>
        <p>Atualize o que quiser. A data original do registro será mantida.</p>
      </div>
    </div>

    <form method="post" action="/entry/{{ entry.id }}/edit" class="duo-edit-form">
      <label class="duo-field">
        <span>Como você está?</span>
        <input
          type="text"
          name="mood"
          value="{{ entry.mood or '' }}"
          maxlength="180"
          placeholder="Ex.: Leve, cansada, feliz..."
        >
      </label>

      <label class="duo-field">
        <span>Momento especial do dia</span>
        <textarea
          name="moment_special"
          rows="4"
          maxlength="1200"
          placeholder="O que aconteceu e vale a pena guardar?"
        >{{ entry.moment_special or '' }}</textarea>
      </label>

      <label class="duo-field">
        <span>Um gesto de amor</span>
        <textarea
          name="love_action"
          rows="3"
          maxlength="800"
          placeholder="Algo que você fez, recebeu ou gostaria de viver..."
        >{{ entry.love_action or '' }}</textarea>
      </label>

      <div class="duo-grid-two">
        <label class="duo-field">
          <span>Personagem do dia</span>
          <input
            type="text"
            name="character"
            value="{{ entry.character or '' }}"
            maxlength="120"
            placeholder="Quem você foi hoje?"
          >
        </label>

        <label class="duo-field">
          <span>Música do dia</span>
          <input
            type="text"
            name="music"
            value="{{ entry.music or '' }}"
            maxlength="180"
            placeholder="Uma música para este momento"
          >
        </label>
      </div>

      <fieldset class="duo-tags">
        <legend>Recadinhos rápidos</legend>
        <div class="duo-tag-grid">
          {% for key, label in diary_tags.items() %}
          <label class="duo-tag-option">
            <input
              type="checkbox"
              name="tags"
              value="{{ key }}"
              {% if key in entry_tags %}checked{% endif %}
            >
            <span>{{ label }}</span>
          </label>
          {% endfor %}
        </div>
      </fieldset>

      <div class="duo-edit-actions">
        <a href="/" class="duo-btn duo-btn-secondary">Cancelar</a>
        <button type="submit" class="duo-btn duo-btn-primary">Salvar alterações 💙</button>
      </div>
    </form>
  </div>
</section>

<style>
  .duo-edit-page {
    min-height: calc(100vh - 90px);
    padding: 38px 18px 60px;
    background:
      radial-gradient(circle at 10% 20%, rgba(111, 91, 255, .10), transparent 24%),
      radial-gradient(circle at 90% 10%, rgba(67, 147, 255, .12), transparent 26%),
      #fbfaf7;
  }

  .duo-edit-card {
    width: min(860px, 100%);
    margin: 0 auto;
    padding: 30px;
    border: 1px solid #ece8df;
    border-radius: 28px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 18px 50px rgba(49, 44, 99, .10);
  }

  .duo-edit-heading {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 28px;
  }

  .duo-back {
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    height: 42px;
    border: 1px solid #d9d8ff;
    border-radius: 14px;
    color: #4d46d8;
    background: #f7f7ff;
    font-size: 22px;
    text-decoration: none;
  }

  .duo-kicker {
    color: #6a63ea;
    font-size: .74rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .duo-edit-heading h1 {
    margin: 5px 0 6px;
    color: #2d2a45;
    font-size: clamp(1.65rem, 4vw, 2.2rem);
  }

  .duo-edit-heading p {
    margin: 0;
    color: #777286;
  }

  .duo-edit-form {
    display: grid;
    gap: 20px;
  }

  .duo-field {
    display: grid;
    gap: 8px;
  }

  .duo-field > span,
  .duo-tags legend {
    color: #403b56;
    font-weight: 800;
    font-size: .93rem;
  }

  .duo-field input,
  .duo-field textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #dedbea;
    border-radius: 16px;
    padding: 14px 16px;
    color: #39354b;
    background: #fcfbff;
    font: inherit;
    outline: none;
    transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }

  .duo-field textarea {
    resize: vertical;
    min-height: 104px;
  }

  .duo-field input:focus,
  .duo-field textarea:focus {
    border-color: #7770ef;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(119, 112, 239, .12);
  }

  .duo-grid-two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .duo-tags {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .duo-tags legend {
    margin-bottom: 10px;
  }

  .duo-tag-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .duo-tag-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .duo-tag-option span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 13px;
    border: 1px solid #e4e1ef;
    border-radius: 999px;
    color: #5c566b;
    background: #fff;
    cursor: pointer;
    font-size: .88rem;
    font-weight: 700;
    transition: .18s ease;
  }

  .duo-tag-option input:checked + span {
    border-color: #7c74f2;
    color: #443dc5;
    background: #efefff;
    box-shadow: 0 5px 16px rgba(86, 78, 205, .13);
  }

  .duo-edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding-top: 8px;
  }

  .duo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border: 0;
    border-radius: 15px;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
  }

  .duo-btn-secondary {
    color: #5d586b;
    background: #f1eff4;
  }

  .duo-btn-primary {
    color: #fff;
    background: linear-gradient(135deg, #6558ea, #3588f5);
    box-shadow: 0 9px 20px rgba(71, 94, 224, .24);
  }

  @media (max-width: 680px) {
    .duo-edit-card { padding: 22px 16px; border-radius: 22px; }
    .duo-grid-two { grid-template-columns: 1fr; }
    .duo-edit-actions { flex-direction: column-reverse; }
    .duo-btn { width: 100%; }
  }
</style>
{% endblock %}
